{
  "name": "@steerable/agent-shell",
  "version": "0.6.42",
  "description": "Steerable framework \u2014 product-neutral Node HostRuntime and headless HTTP server shared by Tauri desktop and browser deployments; scenario packs extend it through @steerable/pack-sdk.",
  "license": "Apache-2.0",
  "homepage": "https://steerableframework.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathlyapp/steerable.git",
    "directory": "packages/agent-shell/ts"
  },
  "bugs": {
    "url": "https://github.com/pathlyapp/steerable/issues"
  },
  "type": "module",
  "main": "dist/runtime.js",
  "exports": {
    "./host-tools": {
      "types": "./dist/host-tools.d.ts",
      "default": "./dist/host-tools.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./server/start": {
      "types": "./dist/server/start.d.ts",
      "default": "./dist/server/start.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "echo agent-shell-ts",
    "build": "tsc -p tsconfig.json && node copy-skills.mjs && node scripts/build-preload.mjs",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-shell-neutral.mjs && node scripts/check-storage-boundaries.mjs",
    "check:drift": "echo ok",
    "shell:neutral": "node scripts/check-shell-neutral.mjs",
    "storage:boundaries": "node scripts/check-storage-boundaries.mjs",
    "web": "DEEPPATH_WEB_DIST=${DEEPPATH_WEB_DIST:-../web/app/dist} node dist/server/index.js",
    "client": "DEEPPATH_FORCE_BUNDLED_WEB=1 DEEPPATH_WEB_DIST=${DEEPPATH_WEB_DIST:-../web/app/dist} node node_modules/electron/cli.js dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@steerable/agent-harness": "workspace:*",
    "@steerable/agent-protocol": "workspace:*",
    "@steerable/pack-sdk": "workspace:*",
    "better-sqlite3": "^11.9.1",
    "conf": "10.2.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "he": "^1.2.0",
    "node-pty": "^1.1.0",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/he": "^1.2.3",
    "@types/node": "^22.10.5",
    "@types/semver": "^7.8.0",
    "electron": "^28.3.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
