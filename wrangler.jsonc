{
  "name": "steerableframework-docs",
  "account_id": "CLOUDFLARE_ACCOUNT_ID_FROM_ENV",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "steerableframework.com", "custom_domain": true },
    { "pattern": "www.steerableframework.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
